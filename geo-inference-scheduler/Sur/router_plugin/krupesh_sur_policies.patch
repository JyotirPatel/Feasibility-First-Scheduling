+def _register_sur() -> Callable | None:
+    """Register Sur's policies (Sur/router_plugin) under their sur: names only and return Sur's
+    reward function. The plain names in NEEDS_SUR stay unregistered. None if Sur's folder is absent."""
+    for parent in Path(__file__).resolve().parents:
+        sur = parent / "Sur"
+        if (sur / "router_plugin").is_dir():
+            break
+    else:
+        return None
+    if str(sur) not in sys.path:
+        sys.path.append(str(sur))
+    from router_plugin import register, reward_fn
+
+    names: dict = {}
+    register(names)
+    EXTRA_POLICIES.update({k: v for k, v in names.items() if k.startswith("sur:")})
+    return reward_fn
+
+
+SUR_REWARD_FN = _register_sur()
+
+
+def reward_for(policy: str, default: Callable) -> Callable:
+    """The engine's reward: Sur's reward for Sur's policies, `default` (the labelled mock) otherwise."""
+    return SUR_REWARD_FN if SUR_REWARD_FN is not None and policy.startswith("sur:") else default
+
+
 def build_policy(name: str, seed: int = 0, **params) -> Policy:
